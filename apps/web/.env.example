# Copy to .env.local and fill in from the AuthStack outputs (cdk deploy).
VITE_AWS_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# API Gateway endpoint from the ApiStack ApiUrl output (no trailing slash).
VITE_API_URL=

# Local dev only: put these in .env.development.local (git-ignored) so `npm run dev` avoids CORS.
# The API only allows the CloudFront origin, so the dev server forwards /api to it instead.
#   VITE_API_URL=/api
#   VITE_API_PROXY_TARGET=<same ApiUrl as above>
